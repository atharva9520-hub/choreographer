TELEGRAM_BOT_TOKEN=123456:ABC...
# Which LLM to use: groq | gemini | xai. LLM_FALLBACK = backups tried in order.
LLM_PROVIDER=groq
LLM_FALLBACK=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_SHEET_ID=the-long-id-from-the-sheet-url
GOOGLE_CREDENTIALS_FILE=service_account.json
TIMEZONE=America/Chicago
REMINDER_TIME=08:00
WEEKLY_PLAN_TIME=19:00
# Optional: only respond in this group (copy chat_id from the Settings tab after first message)
ALLOWED_CHAT_ID=
# Tried in order if the main model is busy
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash
